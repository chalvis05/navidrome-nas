# Copy to .env and edit:  cp .env.example .env
# NEVER commit .env (it holds your Deezer ARL). It is in .gitignore.

# ---------- UGREEN NAS paths (UGOS Pro, default storage pool = volume1) ----------
# Shared folder where the Docker app keeps per-app data
APPDATA_DIR=/volume1/docker/music-stack
# Your music library (shared folder). octo-fiesta writes into $MUSIC_DIR/octo-fiesta
MUSIC_DIR=/volume1/Music

# ---------- User / permissions ----------
# SSH into the NAS and run `id` -> use your uid / gid (UGOS admin is usually 1000 / 10)
PUID=1000
PGID=10
TZ=Asia/Manila

# ---------- Ports exposed on the NAS ----------
NAVIDROME_PORT=4533
OCTO_FIESTA_PORT=5274

# ---------- Navidrome ----------
NAVIDROME_TAG=latest
ND_LOGLEVEL=info
ND_SCANNER_SCHEDULE="@every 15m"
ND_SCANNER_WATCHERWAIT=10s
ND_SESSIONTIMEOUT=168h

# ---------- octo-fiesta ----------
OCTO_FIESTA_IMAGE=ghcr.io/v1ck3s/octo-fiesta:latest
# Used only if you switch to build-from-source in docker-compose.yml
OCTO_FIESTA_GIT=https://github.com/V1ck3s/octo-fiesta.git#main

MUSIC_SERVICE=Deezer
# Permanent = keep downloads in the library | Cache = temporary
STORAGE_MODE=Permanent
# Track = only the requested track | Album = whole album
DOWNLOAD_MODE=Track
# All | ExplicitOnly | CleanOnly
EXPLICIT_FILTER=All

# ---------- Deezer ----------
# Browser -> log in to deezer.com -> DevTools -> Application -> Cookies -> "arl"
DEEZER_ARL=paste_your_arl_cookie_here
DEEZER_ARL_FALLBACK=
# FLAC | MP3_320 | MP3_128  (FLAC requires Deezer HiFi/Premium)
DEEZER_QUALITY=FLAC
